{
  "name": "aivora-studio",
  "version": "1.7.0",
  "private": true,
  "description": "AIVORA Studio — AI-native motion comic & short-drama desktop workbench",
  "author": "AIVORA Studio <aivora@users.noreply.github.com>",
  "homepage": "https://github.com/chen11-A/aivora-studio",
  "license": "Apache-2.0",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint src scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:layout": "node scripts/layout-audit.mjs",
    "build:win": "pnpm build && electron-builder --win nsis --x64 --publish never",
    "build:win:dir": "pnpm build && electron-builder --win --dir --x64 --publish never",
    "build:linux": "pnpm build && electron-builder --linux AppImage deb --x64 --publish never",
    "build:linux:dir": "pnpm build && electron-builder --linux dir --x64 --publish never"
  },
  "dependencies": {
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@tailwindcss/vite": "^4.1.8",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^36.3.2",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "eslint": "^9.27.0",
    "playwright-core": "^1.52.0",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
